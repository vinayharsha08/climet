{
  "name": "nercp-emergency-platform",
  "version": "1.0.0",
  "description": "National Emergency Resource & Relief Coordination Platform - Vijayawada Flood Emergency 2026",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm run dev --prefix client",
    "install:client": "npm install --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/index.js"
  },
  "keywords": [
    "emergency-response",
    "disaster-management",
    "resource-allocation",
    "command-center",
    "vijayawada-floods"
  ],
  "author": "NERCP Team",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^9.2.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1"
  }
}
